# Roobet affiliate API credentials (Roobet -> Affiliate -> API). Never commit real values.
ROOBET_API_TOKEN=
ROOBET_USER_ID=

# Fourthwall storefront token (Fourthwall -> Settings -> For developers). Enables the Merch tab's product grid.
FOURTHWALL_STOREFRONT_TOKEN=

# Kick developer app (kick.com/settings/developer) with the kicks:read and user:read scopes.
# kicks:read powers the KICKs leaderboard; user:read powers "Log in with Kick" on /admin.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Random secret that guards /api/kick/login so only the site owner can connect a Kick account.
# It also signs /admin sessions, so changing it signs every admin out.
KICK_ADMIN_KEY=

# Upstash Redis (Vercel -> Storage -> Upstash for Redis) stores the Kick login between refreshes.
# Vercel sets these automatically when the database is connected to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
